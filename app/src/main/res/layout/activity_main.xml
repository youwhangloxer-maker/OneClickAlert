<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:fitsSystemWindows="true"
    android:background="@color/bg">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- 알림 버튼 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="320dp">

            <Button
                android:id="@+id/alertBtn"
                android:layout_width="260dp"
                android:layout_height="260dp"
                android:layout_gravity="center"
                android:background="@drawable/bg_alert"
                android:elevation="8dp"
                android:stateListAnimator="@null"
                android:text="알림"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:textStyle="bold"
                android:contentDescription="알림 울리기" />
        </FrameLayout>

        <!-- 주변 소리 듣기 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="주변 소리 듣기"
                        android:textColor="@color/fg"
                        android:textSize="17sp"
                        android:textStyle="bold" />
                    <TextView
                        android:id="@+id/micStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="꺼짐"
                        android:textColor="@color/muted"
                        android:textSize="13sp" />
                </LinearLayout>

                <Button
                    android:id="@+id/micBtn"
                    style="@style/Pill"
                    android:text="켜기" />
            </LinearLayout>

            <ProgressBar
                android:id="@+id/meter"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="6dp"
                android:layout_marginTop="14dp"
                android:max="100"
                android:progress="0"
                android:progressTint="@color/live"
                android:progressBackgroundTint="@color/line" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:orientation="horizontal">
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="음량"
                    android:textColor="@color/muted"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/volVal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="150%"
                    android:textColor="@color/muted"
                    android:textSize="14sp" />
            </LinearLayout>

            <SeekBar
                android:id="@+id/vol"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:max="400"
                android:progress="150"
                android:progressTint="@color/live"
                android:thumbTint="@color/live"
                android:contentDescription="음량" />

            <TextView
                style="@style/Note"
                android:text="반드시 이어폰을 먼저 연결하세요. 스피커로 들으면 하울링이 생깁니다." />
        </LinearLayout>

        <!-- 마이크 권한 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_panel"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="16dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="마이크 권한"
                    android:textColor="@color/fg"
                    android:textSize="17sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/permStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/muted"
                    android:textSize="13sp" />
            </LinearLayout>

            <Button
                android:id="@+id/permBtn"
                style="@style/Pill"
                android:text="권한 설정" />
        </LinearLayout>

        <!-- 안내 음성 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_panel"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="안내 음성"
                android:textColor="@color/fg"
                android:textSize="17sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/voiceStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="@color/muted"
                android:textSize="13sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/voicePick"
                    style="@style/Pill"
                    android:text="mp3 선택" />
                <Button
                    android:id="@+id/voiceTest"
                    style="@style/Pill"
                    android:layout_marginStart="10dp"
                    android:text="미리 듣기" />
            </LinearLayout>

            <TextView
                style="@style/Note"
                android:text="고른 파일은 앱에 기억돼서 다음에 열어도 그대로 쓰여요." />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
